# ---- Wersja i porty ---------------------------------------------------------
ARTIFACTORY_VERSION=latest
ARTIFACTORY_PORT=8082      # UI + REST API + publikacja (wymaga poswiadczen)
READ_PROXY_PORT=8083       # anonimowy odczyt dla Spec Kita (tylko GET/HEAD)

# ---- Baza danych (WYMAGANA: Artifactory nie startuje juz na Derby) ---------
DB_NAME=artifactory
DB_USER=artifactory
DB_PASSWORD=zmien-mnie

# ---- Konto administratora ---------------------------------------------------
# Artifactory OSS blokuje API bezpieczenstwa, wiec hasla admina NIE da sie
# zmienic skryptem - tylko w UI (http://localhost:8082/ui/, kreator przy
# pierwszym logowaniu). Trzymaj tu wartosc, ktora faktycznie dziala.
# Domyslne haslo swiezej instancji to "password".
ADMIN_USER=admin
ADMIN_PASSWORD=password

# ---- Token odczytu (tylko dla wdrozen publicznych) --------------------------
# Lokalnie zostaw puste: read-proxy sluchа tylko na localhoscie.
# Na Railwayu USTAW - patrz railway/README.md.
READ_TOKEN=

# ---- Repozytorium -----------------------------------------------------------
REPO_KEY=generic-local

# Uwaga: nie ma tu kont reader/deployer. Na OSS nie da sie ich utworzyc przez
# REST (Pro-only), dlatego lokalnie wszystko robi admin, a odczyt dla Spec Kita
# idzie przez read-proxy na porcie READ_PROXY_PORT. Rozdzial rol wraca na
# firmowym Artifactory - patrz docs/ARTIFACTORY.md w rbal-speckit-toolkit.
